# Database Connection (Neon PostgreSQL Cloud / Local PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-sample-host.aws.neon.tech/neondb?sslmode=require

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=1d

# Server Configuration
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Shop & Business Profile Defaults
